# 必填：账号别名列表。多个别名用英文逗号分隔，只使用字母、数字和下划线。
ALIYUN_ACCOUNTS=PRIMARY,SECONDARY

# 必填：PRIMARY 账号的 AccessKey ID。
ALIYUN_PRIMARY_ACCESS_KEY_ID=your_primary_access_key_id
# 必填：PRIMARY 账号的 AccessKey Secret。
ALIYUN_PRIMARY_ACCESS_KEY_SECRET=your_primary_access_key_secret
# 可选：PRIMARY 账号的 ECS 安全组，格式为 地域ID:安全组ID；多个目标用英文逗号分隔。
ALIYUN_PRIMARY_SECURITY_GROUPS=cn-chengdu:sg-example1,cn-hangzhou:sg-example2
# 可选：PRIMARY 账号的 RDS 实例 ID；多个目标用英文逗号分隔，没有则留空。
ALIYUN_PRIMARY_RDS_INSTANCES=rm-example1,rm-example2

# 必填：SECONDARY 账号的 AccessKey ID。
ALIYUN_SECONDARY_ACCESS_KEY_ID=your_secondary_access_key_id
# 必填：SECONDARY 账号的 AccessKey Secret。
ALIYUN_SECONDARY_ACCESS_KEY_SECRET=your_secondary_access_key_secret
# 可选：SECONDARY 账号的 ECS 安全组。
ALIYUN_SECONDARY_SECURITY_GROUPS=cn-shanghai:sg-example3
# 可选：SECONDARY 账号的 RDS 实例 ID。
ALIYUN_SECONDARY_RDS_INSTANCES=rm-example3

# 必填：ECS 自动同步规则的描述前缀。实际规则描述为“前缀:1”“前缀:2”，区分大小写。
ALIYUN_ECS_RULE_DESCRIPTION=自动同步
# 必填：程序独占管理的 RDS 白名单分组，禁止留空或填写 default。
ALIYUN_RDS_WHITELIST_NAME=aliyun_sync_local_ip

# 可选：允许同步的国家和省份，忽略大小写；两项都留空或删除时不限制地域。
IP_ALLOWED_COUNTRY=CN
IP_ALLOWED_REGION=Guizhou
# 可选：公网 IP 检查间隔，单位为秒，默认 600 秒。
CHECK_INTERVAL_SECONDS=600
# 可选：IPInfo Token；没有可留空，IPInfo 仅是多个归属地接口之一。
IPINFO_TOKEN=
# 可选：成功同步后的 IP 缓存文件；相对路径以项目目录为基准。
IP_CACHE_FILE=.last_ip
# 可选：飞书群机器人 Webhook 地址；本地公网 IP 变更且同步成功后发送通知。
FEISHU_WEBHOOK_URL=
